<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET Framework 4.8 มีในทุก Windows 10/11 อยู่แล้ว → exe ไฟล์เดียว ไม่ต้องติดตั้งอะไรเพิ่ม
    หน้าจอเป็น HTML (ui/index.html) ฝังอยู่ใน exe เปิดผ่านหน้าต่างแอปของ Microsoft Edge
    build บน Windows/Linux ได้ด้วย .NET SDK 8:  dotnet build -c Release
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Dikai.App</RootNamespace>
    <AssemblyName>DikaiD03S</AssemblyName>
    <Version>1.1.0</Version>
    <Product>Dikai D03S Sender</Product>
    <AssemblyTitle>Dikai D03S — ส่งข้อมูลเครื่องพิมพ์ (DGCP v2.0)</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Protocol\*.cs" Link="Protocol\%(Filename)%(Extension)" />
    <EmbeddedResource Include="ui\index.html" LogicalName="DikaiD03S.ui.index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
